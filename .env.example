# PropAI environment configuration — copy to .env and fill in.
# .env is gitignored. Never commit real values.

# --- LLM proxy (AgentRouter / 9router, OpenAI-compatible) -------------------
# The openai SDK takes base_url directly, so any OpenAI-compatible proxy works.
LLM_BASE_URL=https://your-proxy.example.com/v1
LLM_API_TOKEN=
LLM_MODEL=gpt-5.6

# Cheaper tier for high-volume 24/7 chat. Falls back to LLM_MODEL if unset.
LLM_MODEL_CHAT=gpt-5.6-luna
LLM_IMAGE_MODEL=gpt-image-2
LLM_EMBEDDING_MODEL=text-embedding-3-small

# --- Provider mode ----------------------------------------------------------
# real = call the proxy. fake = fixture-backed, no network, no token.
# The test suite forces fake regardless of this value.
PROPAI_PROVIDER_MODE=fake

# --- Database ---------------------------------------------------------------
POSTGRES_USER=propai
POSTGRES_PASSWORD=change-me-in-env
POSTGRES_DB=propai
DATABASE_URL=postgresql+psycopg://propai:change-me-in-env@postgres:5432/propai

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Salt for hashing click IPs. Must be stable, or click dedup breaks.
IP_HASH_SALT=

# --- Public URLs ------------------------------------------------------------
# Base for short links: PUBLIC_BASE_URL/r/{code}
PUBLIC_BASE_URL=http://localhost:8000

# --- WhatsApp (optional; wa.me needs no credentials) ------------------------
# Agency WhatsApp number in international format, no + or spaces.
WHATSAPP_AGENCY_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+17372212163
